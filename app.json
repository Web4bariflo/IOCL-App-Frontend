{
  "expo": {
    "name": "IOCL APP",
    "slug": "iocl-app",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/bariflo.png",

    "scheme": "ioclapp",
    "userInterfaceStyle": "automatic",

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bariflo.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "ios": {
      "icon": "./assets/images/bariflo.png"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/bariflo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/bariflo.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
