{
  "expo": {
    "name": "IOCL APP",
    "slug": "iocl-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bariflo-icon.png",
    "scheme": "ioclapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bariflo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bariflo.ioclapp"
    },
    "ios": {
      "icon": "./assets/images/bariflo-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bariflo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/bariflo.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
